# Geocoding
geocoding/

# Geocoding data and sensitive files
geocoding/*.csv
geocoding/*.xlsx
geocoding/*.tsv
geocoding/*.json
geocoding/*.env
geocoding/*.pkl
geocoding/*.pickle
geocoding/*.db
geocoding/*.sqlite
geocoding/*.log
geocoding/~$*.xlsx
geocoding/~$*.xls

# Environment variables
.env
*.csv
*.xlsx
*.tsv

# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Distribution / packaging
dist/
# ...except phylotree's, which is a browser build, not packaging output:
# pages/phylotree.html loads ./node_modules/phylotree/dist/phylotree.{js,css}
# by that exact path. Upstream (EarthBiogenome/dashboard) keeps those three
# files tracked only because they were force-added before this rule existed,
# so a fresh copy of the tree drops them and the page 404s on its own library.
!pages/node_modules/phylotree/dist/
build/
*.egg-info/


# Virtual environment
.venv/
venv/
env/
ENV/

# IDE settings
.vscode/
.idea/

# Output files
*.csv
*.xlsx
*.tsv
*.png
!pages/geoMap/logo.png

# Google Analytics 4 - Keep credentials secret but allow data files
web-analytics/ga4_service_account.json
web-analytics/ga4_config.json

# Allow web analytics data files (exception to global *.csv/*.json rules)
# Must un-ignore directory first, then un-ignore specific files
!web-analytics/
web-analytics/*
!web-analytics/weekly_analytics_*.json
!web-analytics/weekly_web_analytics.csv
!web-analytics/*.png
!web-analytics/*.py
!web-analytics/*.md
!web-analytics/requirements.txt
!web-analytics/archive/

# GitHub Repository Analytics - IMPORTANT: These files should be tracked for historical data
# Allow repo analytics data files (exception to global *.csv rules)
# Must un-ignore directory first, then un-ignore specific files
!repo-analytics/
repo-analytics/*
!repo-analytics/traffic-*.json
!repo-analytics/weekly_summary.csv
!repo-analytics/*.png
!repo-analytics/*.py
!repo-analytics/*.md
!repo-analytics/archive/

# v3 API experiments — throwaway playground, not production (see _v3-experiments/)
_v3-experiments/

# Design concept mockups — local-only vision/design artifacts, not production pages
_design-concepts/